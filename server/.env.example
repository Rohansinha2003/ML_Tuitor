# ==============================================================================
# DEEPNOVA BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network & Runtime Configuration
PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 1. DATABASE (MongoDB Atlas or Local MongoDB)
# Leave empty to automatically use in-memory MongoDB for local development.
# When ready for persistent storage, paste your MongoDB connection string below.
# Get free cluster at: https://cloud.mongodb.com/
# ------------------------------------------------------------------------------
MONGODB_URI=

# ------------------------------------------------------------------------------
# 2. JWT SECURITY KEYS
# Cryptographically strong 256-bit random secrets
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters

# ------------------------------------------------------------------------------
# 3. FREE EMAIL SMTP (Gmail App Password)
# Used for account email verification and password reset emails.
# Instructions:
#  1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
#  2. Generate 16-character App Password: https://myaccount.google.com/apppasswords
#  3. Paste your email and 16-character password below (leave empty to skip email verification)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM=
SMTP_USER=
SMTP_PASSWORD=

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 (Google Sign-In)
# Used for "Continue with Google" one-click authentication.
# Run `npm run check:env` afterwards to test these values against Google.
# Instructions:
#  1. Go to Google Cloud Console: https://console.cloud.google.com/apis/credentials
#  2. Create an OAuth 2.0 Client ID (Web Application)
#  3. Authorized redirect URIs (add both, each must match exactly):
#       http://localhost:5001/api/auth/google/callback
#       https://YOUR-PRODUCTION-DOMAIN/api/auth/google/callback
#  4. Paste Client ID and Secret below (leave empty to disable Google sign-in)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback
